# Common
TZ=Europe/Berlin

# Postgres (course DB)
POSTGRES_USER=course
POSTGRES_PASSWORD=course
POSTGRES_DB=course
POSTGRES_PORT=5432

# Jupyter
JUPYTER_TOKEN=course
JUPYTER_PORT=8888

# Airflow
AIRFLOW_PORT=8083
AIRFLOW_DB_PORT=5434
AIRFLOW_UID=50000
AIRFLOW_WEB_USER=airflow
AIRFLOW_WEB_PASSWORD=airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_PAUSED_AT_CREATION=true

# Hadoop / Spark
HADOOP_CLUSTER_NAME=bigdata-env
NAMENODE_HTTP_PORT=9870
NAMENODE_RPC_PORT=8020
DATANODE_HTTP_PORT=9864
RESOURCEMANAGER_PORT=8088
NODEMANAGER_PORT=8042
HISTORYSERVER_PORT=8188
SPARK_NOTEBOOK_PORT=8889
SPARK_UI_PORT=4040

# Hive
HIVE_METASTORE_PORT=9083
HIVE_SERVER_PORT=10000

# Postgres target for batch load
POSTGRES_TGT_USER=postgres
POSTGRES_TGT_PASSWORD=postgres
POSTGRES_TGT_DB=postgres
POSTGRES_TGT_PORT=5433
PG_JDBC_DRIVER_LOCAL_PATH=spark-client/drivers/postgresql-42.7.2.jar
PG_JDBC_DRIVER_HDFS_PATH=hdfs:///drivers/postgresql-42.7.2.jar

# Public API
WORLD_BANK_API_BASE=https://api.worldbank.org/v2
